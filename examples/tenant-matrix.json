{
  "version": 1,
  "environment": "local",
  "base_url": "http://127.0.0.1:8766",
  "actors": {
    "a-owner": {"token_env": "AUTHMATRIX_A_OWNER_TOKEN"},
    "a-peer": {"token_env": "AUTHMATRIX_A_PEER_TOKEN"},
    "a-admin": {"token_env": "AUTHMATRIX_A_ADMIN_TOKEN"},
    "b-owner": {"token_env": "AUTHMATRIX_B_OWNER_TOKEN"},
    "b-admin": {"token_env": "AUTHMATRIX_B_ADMIN_TOKEN"},
    "anonymous": {"token_env": null}
  },
  "cases": [
    {"id": "a-owner-own", "actor": "a-owner", "method": "GET", "path": "/documents/a-1", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "a"}, {"id": "record", "path": ["record"], "op": "equals", "value": "a-1"}]},
    {"id": "a-peer-own", "actor": "a-peer", "method": "GET", "path": "/documents/a-2", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "a"}, {"id": "record", "path": ["record"], "op": "equals", "value": "a-2"}]},
    {"id": "a-owner-other", "actor": "a-owner", "method": "GET", "path": "/documents/a-2", "expect_status": [403]},
    {"id": "a-peer-other", "actor": "a-peer", "method": "GET", "path": "/documents/a-1", "expect_status": [403]},
    {"id": "a-admin-document", "actor": "a-admin", "method": "GET", "path": "/documents/a-1", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "a"}, {"id": "record", "path": ["record"], "op": "equals", "value": "a-1"}]},
    {"id": "b-owner-own", "actor": "b-owner", "method": "GET", "path": "/documents/b-1", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "b"}, {"id": "record", "path": ["record"], "op": "equals", "value": "b-1"}]},
    {"id": "b-admin-document", "actor": "b-admin", "method": "GET", "path": "/documents/b-1", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "b"}, {"id": "record", "path": ["record"], "op": "equals", "value": "b-1"}]},
    {"id": "a-owner-summary", "actor": "a-owner", "method": "GET", "path": "/tenants/a/summary", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "a"}, {"id": "view", "path": ["view"], "op": "equals", "value": "summary"}]},
    {"id": "b-owner-summary", "actor": "b-owner", "method": "GET", "path": "/tenants/b/summary", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "b"}, {"id": "view", "path": ["view"], "op": "equals", "value": "summary"}]},
    {"id": "a-member-cross-summary", "actor": "a-owner", "method": "GET", "path": "/tenants/b/summary", "expect_status": [403]},
    {"id": "b-member-cross-summary", "actor": "b-owner", "method": "GET", "path": "/tenants/a/summary", "expect_status": [403]},
    {"id": "a-admin-cross-document", "actor": "a-admin", "method": "GET", "path": "/documents/b-1", "expect_status": [403]},
    {"id": "b-admin-cross-document", "actor": "b-admin", "method": "GET", "path": "/documents/a-1", "expect_status": [403]},
    {"id": "a-admin-report", "actor": "a-admin", "method": "GET", "path": "/tenants/a/admin", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "a"}, {"id": "view", "path": ["view"], "op": "equals", "value": "admin"}]},
    {"id": "b-admin-report", "actor": "b-admin", "method": "GET", "path": "/tenants/b/admin", "expect_status": [200],
     "assert_json": [{"id": "scope", "path": ["tenant"], "op": "equals", "value": "b"}, {"id": "view", "path": ["view"], "op": "equals", "value": "admin"}]},
    {"id": "a-member-admin-denied", "actor": "a-owner", "method": "GET", "path": "/tenants/a/admin", "expect_status": [403]},
    {"id": "b-member-admin-denied", "actor": "b-owner", "method": "GET", "path": "/tenants/b/admin", "expect_status": [403]},
    {"id": "a-admin-cross-report", "actor": "a-admin", "method": "GET", "path": "/tenants/b/admin", "expect_status": [403]},
    {"id": "b-admin-cross-report", "actor": "b-admin", "method": "GET", "path": "/tenants/a/admin", "expect_status": [403]},
    {"id": "anonymous-document", "actor": "anonymous", "method": "GET", "path": "/documents/a-1", "expect_status": [401]},
    {"id": "anonymous-admin", "actor": "anonymous", "method": "GET", "path": "/tenants/a/admin", "expect_status": [401]}
  ]
}
