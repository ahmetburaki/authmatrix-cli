include README.md LICENSE CHANGELOG.md CONTRIBUTING.md pyproject.toml .gitignore
recursive-include authmatrix *.py *.json
recursive-include docs *.md
recursive-include examples *.py *.json
recursive-include tests *.py *.json *.md
recursive-include tools *.py
include requirements/packaging.txt
global-exclude *.py[cod]
prune .git
prune .github
prune .local-tls
prune evidence
prune dist
prune build
