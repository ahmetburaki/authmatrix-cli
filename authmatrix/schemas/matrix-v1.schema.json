{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ahmetburaki/authmatrix-cli/main/authmatrix/schemas/matrix-v1.schema.json",
  "title": "AuthMatrix matrix version 1",
  "description": "Structural contract only. Use authmatrix validate for target scope, unique IDs, actor references and strict numeric representation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "environment", "base_url", "actors", "cases"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "environment": {"enum": ["local", "staging"]},
    "base_url": {
      "type": "string",
      "minLength": 1,
      "description": "Literal-IP origin. Runtime validation enforces local/private scope, HTTPS for staging, port and origin restrictions."
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/label"},
      "additionalProperties": {"$ref": "#/$defs/actor"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {"pattern": "[^A-Za-z0-9_-]"}
    },
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_env"],
      "properties": {
        "token_env": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Z_]",
              "not": {"pattern": "[^A-Z0-9_]"}
            }
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "op"],
      "properties": {
        "id": {"$ref": "#/$defs/label"},
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {"type": "string", "maxLength": 256},
              {"type": "integer", "minimum": 0, "maximum": 1000000}
            ]
          }
        },
        "op": {"enum": ["equals", "present", "absent"]},
        "value": {
          "type": ["string", "number", "boolean", "null"],
          "maxLength": 4096
        }
      },
      "if": {"properties": {"op": {"const": "equals"}}},
      "then": {"required": ["value"]},
      "else": {"not": {"required": ["value"]}}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "method", "path", "expect_status"],
      "properties": {
        "id": {"$ref": "#/$defs/label"},
        "actor": {"$ref": "#/$defs/label"},
        "method": {"enum": ["GET", "HEAD"]},
        "path": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^/(?!/)",
          "not": {"pattern": "[^!-~]|[#\\\\]"}
        },
        "expect_status": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/status"}
        },
        "assert_json": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/assertion"}
        }
      },
      "if": {"required": ["assert_json"]},
      "then": {"properties": {"method": {"const": "GET"}}}
    }
  }
}
