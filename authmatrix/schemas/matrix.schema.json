{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ahmetburaki/authmatrix-cli/main/authmatrix/schemas/matrix.schema.json",
  "title": "AuthMatrix matrices versions 1 and 2",
  "description": "Structural contract only. Runtime validation enforces literal-IP scope or a canonical HTTPS staging hostname with a private/loopback pin, unique IDs, actor references and strict numeric representation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "environment",
    "base_url",
    "actors",
    "cases"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "environment": {
      "enum": [
        "local",
        "staging"
      ]
    },
    "base_url": {
      "type": "string",
      "minLength": 1,
      "description": "Version 1: literal-IP origin. Version 2: canonical lowercase ASCII HTTPS hostname origin with connect_ip. Runtime validation enforces scope and origin restrictions."
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/label"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actor"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "connect_ip": {
      "type": "string",
      "minLength": 1,
      "description": "Version 2 only: explicit loopback, RFC1918 or IPv6 ULA pin. No hostname DNS lookup is performed."
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_env"
      ],
      "properties": {
        "token_env": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Z_]",
              "not": {
                "pattern": "[^A-Z0-9_]"
              }
            }
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "op"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            ]
          }
        },
        "op": {
          "enum": [
            "equals",
            "present",
            "absent"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 4096
        }
      },
      "if": {
        "properties": {
          "op": {
            "const": "equals"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      },
      "else": {
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "method",
        "path",
        "expect_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "actor": {
          "$ref": "#/$defs/label"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^/(?!/)",
          "not": {
            "pattern": "[^!-~]|[#\\\\]"
          }
        },
        "expect_status": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/status"
          }
        },
        "assert_json": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      },
      "if": {
        "required": [
          "assert_json"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "const": "GET"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "connect_ip"
        ],
        "properties": {
          "environment": {
            "const": "staging"
          },
          "base_url": {
            "pattern": "^https://"
          }
        }
      },
      "else": {
        "properties": {
          "connect_ip": false
        }
      }
    }
  ]
}
